# dependencies and build output (rebuilt inside the image)
node_modules
dist
coverage

# env files never go into the build context
# (dev reads .env.development via the bind mount, build gets .env.production as a secret)
.env
.env.*

# VCS / editor / OS noise
.git
.gitignore
.github
.vscode
.idea
.DS_Store
*.log

# docker files themselves
Dockerfile
.dockerignore
compose*.yaml
compose*.yml
docker-compose*.yml

README.md